{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Reader",
  "version": "0.1.0",
  "identifier": "com.simon-lei.tiny-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiny Reader",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://tiny-reader-1251477527.cos.ap-guangzhou.myqcloud.com/latest.json"
      ],
        "dialog": false,
        "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEREFBQUUxOTIyMzdBOUYKUldTZmVpT1M0YXJhZlpYRE8rRXpWOE9Jd3VRdHR3Q1JqdHFjbENHWU1DUXprcU1wVGMwZ2Rsby8K",
        "windows": {
          "installMode": "passive"
        }
    }
  },
    "bundle": {
      "active": true,
      "targets": [
        "nsis",
        "updater",
        "dmg",
        "app"
      ],
      "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
